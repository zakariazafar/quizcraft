{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quizcraft/schema/quiz.schema.json",
  "title": "QuizCraft quiz file",
  "description": "One quiz. Extra rules (exactly one correct answer, unique ids, NFC text, answer spread) are enforced by src/lib/validate.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "active", "title", "language", "createdAt", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{1,58})[a-z0-9]$" },
    "version": { "type": "integer", "minimum": 1 },
    "active": { "type": "boolean" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 1000 },
    "language": { "enum": ["ar", "en", "mixed"] },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "maxLength": 500 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "options", "correct", "explanation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,20}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]{1,5}$" },
                "text": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          },
          "correct": { "type": "string" },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 1500 }
        }
      }
    }
  }
}

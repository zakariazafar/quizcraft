# Firebase web app config (Project settings → Your apps). Not secret: security rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Fixed Firebase Auth account the dashboard password signs into. Never put the password here.
VITE_DASHBOARD_EMAIL=dashboard@quizcraft.local

# Optional: reCAPTCHA v3 site key for Firebase App Check
VITE_RECAPTCHA_SITE_KEY=

# Public site URL used for share links (falls back to the current origin)
VITE_SITE_URL=http://localhost:5173

# true = use the local Firebase Emulator Suite (development and tests)
VITE_USE_EMULATORS=true

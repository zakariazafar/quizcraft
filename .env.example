# Firebase web app config (Project settings → Your apps). Not secret: security rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Fixed Firebase Auth account the dashboard password signs into. Never put the password here.
VITE_DASHBOARD_EMAIL=dashboard@quizcraft.local

# Optional: reCAPTCHA v3 site key for Firebase App Check
VITE_RECAPTCHA_SITE_KEY=

# Public site URL used for share links (falls back to the current origin)
VITE_SITE_URL=http://localhost:5173

# Optional: EmailJS (client-side email API; this site has no backend of its own to send
# mail from). Leave all three blank to hide "Email me this result" / dashboard "Email
# result" entirely. Sign up free at emailjs.com, add an email service, and create a
# template with {{to_email}}, {{to_name}}, {{quiz_title}}, {{score}}, {{total}},
# {{percent}} and {{message}} variables (README → Deployment has full steps).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# true = use the local Firebase Emulator Suite (development and tests)
VITE_USE_EMULATORS=true
# Host of the emulators (default 127.0.0.1)
VITE_EMULATOR_HOST=127.0.0.1
